{
    "name": "survos/grist-bundle",
    "description": "Grist forms and agent tools for Symfony.",
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "survos/grist-php": "^2.24",
        "survos/kit-bundle": "^2.6",
        "survos/record-store-bundle": "^2.24",
        "symfony/cache-contracts": "^3.6|^4.0",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "api-platform/core": "^4.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/ai-agent": "^0.13",
        "symfony/cache": "^8.1",
        "symfony/mcp-bundle": "^0.13"
    },
    "suggest": {
        "api-platform/core": "Serve Grist tables as API Platform resources (see docs/api-platform.md).",
        "symfony/ai-agent": "Expose Grist agent tools.",
        "symfony/mcp-bundle": "Expose Grist tools over MCP."
    },
    "autoload": {
        "psr-4": {
            "Survos\\GristBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\GristBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "^8.1"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    }
}
